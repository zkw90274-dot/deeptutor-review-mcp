    "FigurePanel": {
      "additionalProperties": false,
      "description": "One panel of a shared-x-axis engineering figure.\n\n``shear`` panels draw piecewise-constant segments (Q diagrams); ``moment``\nand ``line`` panels draw a polyline/area through points. Positive and\nnegative values are coloured differently and always labelled with their\nnumeric value, so colour is not the only information channel.",
      "properties": {
        "kind": {
          "default": "line",
          "enum": [
            "shear",
            "moment",
            "line"
          ],
          "title": "Kind",
          "type": "string"
        },
        "marks": {
          "items": {
            "$ref": "#/$defs/FigureMark"
          },
          "title": "Marks",
          "type": "array"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "segments": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Segments",
          "type": "array"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "FigurePanel",
      "type": "object"
    },
