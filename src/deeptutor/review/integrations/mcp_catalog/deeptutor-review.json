{
  "id": "deeptutor-review",
  "display_name": "Review Studio",
  "category": "utility",
  "tier": "curated",
  "trust": "unverified",
  "transport": "streamableHttp",
  "description": {
    "en": "Spaced-repetition review packs from your DeepTutor knowledge bases: today's queue, graded hints, self-assessment, weak concepts, offline export, and chapter generation.",
    "zh": "把 DeepTutor 知识库变成间隔复习包：今日队列、分级提示、自评、薄弱概念、离线导出与按章生成。"
  },
  "requires": {
    "en": "Your own public HTTPS Review Studio MCP endpoint and its bearer token. The user-level store cannot reach loopback or private addresses.",
    "zh": "需要你自己的公网 HTTPS Review Studio MCP 地址与访问令牌；用户级商店无法访问 loopback 或私网地址。"
  },
  "server": {
    "url": "https://review.example.com/mcp",
    "tool_timeout": 60,
    "enabled_tools": [
      "review_specs",
      "review_today",
      "review_attempt",
      "review_hint",
      "review_weakness",
      "review_export_link",
      "review_export_tree",
      "review_book_figures",
      "review_generate",
      "review_plan"
    ]
  },
  "fields": [
    {
      "key": "url",
      "label": {
        "en": "Review MCP URL",
        "zh": "Review MCP 地址"
      },
      "target": [
        "url",
        "url"
      ],
      "secret": false,
      "required": true,
      "placeholder": "https://review.example.com/mcp"
    },
    {
      "key": "token",
      "label": {
        "en": "Bearer token",
        "zh": "访问令牌"
      },
      "target": [
        "header",
        "Authorization"
      ],
      "secret": true,
      "required": true,
      "placeholder": "YOUR_TOKEN_HERE",
      "value_template": "Bearer {value}"
    }
  ],
  "homepage": "",
  "docs_url": ""
}
